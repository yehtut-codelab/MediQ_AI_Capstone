QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mediq_wait_events
DATA_FILE=../data/raw/TTSH Oct 25 - 04 May 26 - WaitTimeAdded.xlsx

# OPENAI_API_KEY is required — embeddings (wait-event + SOP RAG search) and the LLM
# phrasing/Q&A steps all call the OpenAI API. There is no local/offline fallback.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CORS_ORIGINS=http://localhost:3000

# SOP & healthcare Q&A RAG
QDRANT_SOP_COLLECTION=mediq_sop_docs
SOP_DOCS_DIR=../data/sop_docs
# Default chatbot persona when the request doesn't choose one:
# clinical_staff | clinician | patient | front_desk | trainee  (app/agents/qa_personas.py)
QA_DEFAULT_PERSONA=clinical_staff
# gpt-6-luna only returns reasoning summaries ("thinking") at high effort
QA_REASONING_EFFORT=high
