# repo root: loose files stay local. Only the README is tracked, plus the two
# files the repo cannot work without (.gitignore, docker-compose.yml).
# Folders are unaffected — the rules below decide what is ignored inside them.
/*
!/*/
!/README.md
!/.gitignore
!/docker-compose.yml

# data — never commit patient data or derivatives
data/
data/raw/
data/processed/
Clean_Dataset/
docs/*
!docs/MediQ_AI_APP_SPECIFICATION.md
!docs/MediQ_AI_APP_FRAMEWORK_DECISION.md
!docs/MediQ_AI_APP_PATHWAY_TRIAGE.md
!docs/MediQ_AI_APP_MODEL_INTEGRATION.md
!docs/MediQ_AI_Agents_Architecture_Fig2.png
*.xlsx
*.parquet

# python
__pycache__/
*.pyc
.venv/
.env

# node
node_modules/
.next/

# local registry db (demo data, includes free-text names)
backend/registry.db

# artifacts
backend/models/artifacts/
*.joblib

# large local-only reference/model code dump — not part of the app
models_codes.zip
models_codes/

# generated reports, notes and diagrams — kept locally, not part of the app
BACKEND_AGENTS_REPORT*
*.docx
~$*
report_diagrams/
claude_session.txt

# trained-model hand-over: the app loads only deployment_global_model/
Models/3_Trained_Models.zip
Models/3_Trained_Models/extended_through_may2026/
Models/3_Trained_Models/per_category_models/
